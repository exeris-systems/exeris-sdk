{
  "name": "@exeris-systems/ui-kit",
  "version": "0.1.0",
  "description": "Exeris UI Kit - Base styles and assets for generated components",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exeris-systems/exeris-sdk.git",
    "directory": "exeris-sdk-ui-kit"
  },
  "files": [
    "dist",
    "src",
    "tailwind.preset.js",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./src/styles/index.css",
    "./styles/*": "./src/styles/*",
    "./theme": "./src/styles/theme.css",
    "./tailwind.preset.js": "./tailwind.preset.js"
  },
  "scripts": {
    "build": "tsc",
    "build:css": "tailwindcss -i src/styles/index.css -o dist/styles.css",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "exeris",
    "ui-kit",
    "components",
    "angular",
    "tailwind"
  ],
  "author": "Exeris Team",
  "license": "Apache-2.0",
  "peerDependencies": {
    "tailwindcss": ">=3.4.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}

