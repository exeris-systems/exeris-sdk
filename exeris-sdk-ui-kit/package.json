{
  "name": "@exeris/ui-kit",
  "version": "0.1.0",
  "description": "Exeris UI Kit - Base styles and assets for generated components",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exeris-systems/exeris-sdk.git",
    "directory": "exeris-sdk-ui-kit"
  },
  "files": [
    "dist",
    "src",
    "tailwind.preset.js",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./src/styles/index.css",
    "./styles/*": "./src/styles/*",
    "./theme": "./src/styles/theme.css",
    "./tailwind.preset.js": "./tailwind.preset.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "build:css": "tailwindcss -i src/styles/index.css -o dist/styles.css",
    "lint": "eslint --max-warnings=-1 .",
    "docs:check": "typedoc --emit none",
    "api:check": "api-extractor run",
    "api:accept": "api-extractor run --local",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "prepack": "node -e \"require('node:fs').copyFileSync('../LICENSE', 'LICENSE')\""
  },
  "keywords": [
    "exeris",
    "ui-kit",
    "components",
    "angular",
    "tailwind"
  ],
  "author": "Exeris Team",
  "license": "Apache-2.0",
  "peerDependencies": {
    "tailwindcss": ">=3.4.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-tsdoc": "^0.4.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "homepage": "https://github.com/exeris-systems/exeris-sdk/tree/main/exeris-sdk-ui-kit#readme",
  "bugs": {
    "url": "https://github.com/exeris-systems/exeris-sdk/issues"
  }
}
