<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.exeris</groupId>
        <artifactId>exeris-sdk-parent</artifactId>
        <version>0.12.0-SNAPSHOT</version>
        <relativePath>../exeris-sdk-parent</relativePath>
    </parent>

    <artifactId>exeris-sdk-source-model</artifactId>
    <packaging>jar</packaging>

    <name>Exeris SDK :: Source Model</name>
    <description>
        Canonical AST/metadata types describing an Exeris domain (entities, fields,
        actions, relationships, sagas, projections, graph, UI, system fields).
        This module is the single source of truth for domain shape and is consumed
        by both the annotation processor (build-time extraction) and the future
        source parser/writer used by Studio and IDE plugins for bidirectional sync.
    </description>

    <properties>
        <!-- The AST wire-format version stamped into META-INF/exeris/ast-schema.json, and
             the same number SchemaVersion.CURRENT returns. It lives here because the
             processor path needs it as a compiler argument and SchemaVersion.CURRENT is
             deliberately not a compile-time constant (it is initialized from a method so it
             does not inline into consumers), which puts it out of reach of both the POM and
             the declaration model. The duplication is guarded, not tolerated:
             AstSchemaContractTest fails if the two disagree. Bump both together. -->
        <ast.schema.version>0.12.0</ast.schema.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-sdk-annotations</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The AST JSON Schema is generated from THIS module's own sources, by a
                 processor on the javac processor path. That path is not this project's
                 dependency tree: the published jar stays free of the emitter and of
                 databind, and the enforcer rule below still proves it. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>eu.exeris</groupId>
                                    <artifactId>exeris-sdk-annotation-catalog</artifactId>
                                    <version>${project.version}</version>
                                </path>
                            </annotationProcessorPaths>
                            <annotationProcessors>
                                <processor>eu.exeris.sdk.catalog.AstSchemaProcessor</processor>
                            </annotationProcessors>
                            <compilerArgs>
                                <arg>-Aexeris.schema.sdkVersion=${project.version}</arg>
                                <arg>-Aexeris.schema.astVersion=${ast.schema.version}</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <!-- The schema describes the published surface. Running the
                                 emitter again over the tests would reopen the same output
                                 file and fail, and a schema carrying test fixtures would be
                                 describing something nobody ships. -->
                            <proc>none</proc>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals><goal>jar-no-fork</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 85% instruction + line coverage gate. Source-model is the
                 module where coverage is meaningful (records + builders +
                 convenience logic). Fails the build on regression. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.instruction.coverage.minimum}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.coverage.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ADR-037 zero-coupling guard: source-model is the module every
                 AST-record consumer depends on, so JavaParser must never reach
                 its dependency tree (it lives in exeris-sdk-source-model-io).
                 Enforced in CI; the review skill catches it pre-merge. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-javaparser-zero-coupling</id>
                        <phase>verify</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.github.javaparser</exclude>
                                    </excludes>
                                    <message>ADR-037: JavaParser must stay in exeris-sdk-source-model-io only — it must not appear on this module's dependency tree (zero runtime coupling).</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Semver gate. This module is the reason the gate exists: the AST
                 records are the surface MIGRATION-0.x-to-1.0.md §3 promises may
                 grow a trailing component in a 1.x minor. See the root pom for
                 the baseline and the ruleset. -->
            <plugin>
                <groupId>com.github.siom79.japicmp</groupId>
                <artifactId>japicmp-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>semver-gate</id>
                        <phase>verify</phase>
                        <goals><goal>cmp</goal></goals>
                        <configuration>
                            <!-- The record-growth stance, encoded.

                                 A record that gains a trailing component emits
                                 CONSTRUCTOR_REMOVED for the old canonical ctor, plus
                                 a new ctor and a new accessor. On plugin defaults
                                 that is a hard break, which would block every
                                 post-1.0 facet — blob, job, flow await, graph
                                 multi-hop — since each arrives as a component on an
                                 existing record.

                                 Applied module-wide here because this module IS the
                                 AST and mutation surface: every public type in
                                 `ast` and `mutation` is a record, an enum, or a
                                 record-bearing sealed interface. Elsewhere the same
                                 relaxation is named class by class.

                                 Not weakened by this: removing, renaming or retyping
                                 a component changes its accessor, so METHOD_REMOVED
                                 and METHOD_RETURN_TYPE_CHANGED still break.

                                 Not visible to this: a same-arity, same-type REORDER,
                                 which shows up only in the constructor signal this
                                 override stops reading. RecordComponentOrderTest
                                 closes it; the two are a pair. -->
                            <parameter>
                                <overrideCompatibilityChangeParameters>
                                    <overrideCompatibilityChangeParameter>
                                        <compatibilityChange>CONSTRUCTOR_REMOVED</compatibilityChange>
                                        <binaryCompatible>true</binaryCompatible>
                                        <sourceCompatible>true</sourceCompatible>
                                        <semanticVersionLevel>MINOR</semanticVersionLevel>
                                    </overrideCompatibilityChangeParameter>
                                </overrideCompatibilityChangeParameters>
                            </parameter>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
