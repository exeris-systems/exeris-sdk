<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0
                              https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <servers>
    <!--
      Maven Central (Central Portal, not the retired OSSRH — that was shut down on 2025-06-30,
      and nexus-staging-maven-plugin with the oss.sonatype.org URLs it needs went with it).

      Credentials are a USER TOKEN generated at central.sonatype.com/usertoken — not the account
      password — and arrive from the workflow environment, never from this file.

      The id must match <publishingServerId> in the root POM's `release` profile. There is
      deliberately no github-exeris-* server here: unlike most repositories in this ecosystem,
      the SDK resolves and publishes nothing through GitHub Packages.
    -->
    <server>
      <id>central</id>
      <username>${env.CENTRAL_TOKEN_USERNAME}</username>
      <password>${env.CENTRAL_TOKEN_PASSWORD}</password>
    </server>
  </servers>
</settings>
