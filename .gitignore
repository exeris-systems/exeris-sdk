target/
*.class
*.jar
*.war
*.ear

# IDE
.idea/
*.iml
.vscode/
.project
.classpath
.settings/
.factorypath

# OS
.DS_Store
Thumbs.db

# Maven
.mvn/
mvnw
mvnw.cmd

# Node (ui-kit)
node_modules/
dist/
# typedoc `out` and api-extractor `reportTempFolder`; the committed golden is api/, not build/.
build/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# Coverage / reports
coverage/
*.lcov
*.exec

# Claude Code — local-only settings (shared agents/skills/commands ARE tracked)
.claude/settings.local.json
.claude/worktrees/

# Build-classpath dumps produced by `mvn dependency:build-classpath`; never source.
cp.txt

# The shared guardrail bundle (exeris-systems/.github), checked out locally so the doc gates can
# run outside CI. A checkout of another repository, never content of this one.
.guardrails/

# The eval runner's report. A run is evidence for one pull request, not repository content, and it
# carries a timestamp that would make every run a diff.
working-notes/eval-report.json

# Running the vendored eval runner or hook dispatcher leaves bytecode inside the vendored tree.
# The digest check ignores it — it covers the bytes that were vendored — but an untracked
# directory inside a digest-verified tree is the kind of thing a reader stops to work out.
__pycache__/
