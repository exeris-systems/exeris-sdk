<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>eu.exeris</groupId>
    <artifactId>exeris-sdk-root</artifactId>
    <version>0.12.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Exeris SDK :: Root</name>
    <description>
        Exeris SDK — annotations, source model, and UI kit for Entity-First development.
        Pure API: zero runtime coupling to the Exeris kernel. Apache-2.0.
    </description>
    <url child.project.url.inherit.append.path="false">https://github.com/exeris-systems/exeris-sdk</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>Exeris Systems</name>
        <url>https://exeris.eu</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>arkstack-dev</id>
            <name>Arkadiusz Przychocki</name>
            <email>oss@exeris.eu</email>
            <organization>Exeris Systems</organization>
            <organizationUrl>https://exeris.eu</organizationUrl>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:git://github.com/exeris-systems/exeris-sdk.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/exeris-systems/exeris-sdk.git</developerConnection>
        <url>https://github.com/exeris-systems/exeris-sdk</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/exeris-systems/exeris-sdk/issues</url>
    </issueManagement>

    <distributionManagement>
        <snapshotRepository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-snapshots</url>
        </snapshotRepository>
        <repository>
            <id>central</id>
            <url>https://central.sonatype.com</url>
        </repository>
    </distributionManagement>

    <modules>
        <module>exeris-sdk-bom</module>
        <module>exeris-sdk-parent</module>

        <!-- Build-time generator, ordered before its consumer: exeris-sdk-annotations
             reaches it through <annotationProcessorPaths>, which Maven does not treat
             as a dependency edge for reactor ordering. Declaration order is what puts
             it first. -->
        <module>exeris-sdk-annotation-catalog</module>
        <module>exeris-sdk-annotations</module>
        <module>exeris-sdk-source-model</module>
        <module>exeris-sdk-source-model-io</module>
        <module>exeris-sdk-composition-spec</module>
        <module>exeris-sdk-composition-lifecycle</module>
        <module>exeris-sdk-composition-runtime</module>
        <module>exeris-sdk-tck</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.source>26</maven.compiler.source>
        <maven.compiler.target>26</maven.compiler.target>
        <!-- JDK 25 LTS — the kernel's GA baseline (ADR-069, following kernel ADR-066).
             Do not raise above the kernel's baseline: these jars sit on a consumer's
             compile classpath, and a higher class-file major locks out the LTS-only
             deployments the kernel deliberately admitted. ClassFileBaselineTest guards
             the emitted major, not this property. -->
        <maven.compiler.release>25</maven.compiler.release>
        <maven.build.timestamp.format>yyyyMMdd-HHmmss</maven.build.timestamp.format>

        <!-- Coverage gate for modules that opt in via jacoco:check execution.
             Annotations module is exempt: @interface declarations have no
             executable instructions, so the metric is not meaningful there. -->
        <jacoco.version>0.8.14</jacoco.version>
        <jacoco.line.coverage.minimum>0.85</jacoco.line.coverage.minimum>
        <jacoco.instruction.coverage.minimum>0.85</jacoco.instruction.coverage.minimum>
        <!--
            A coverage check with no tests behind it measures nothing, and jacoco:check is bound
            to `verify`, so any `install -DskipTests` fails on 0% rather than on whatever the
            build was actually asked to prove.

            This is not hypothetical tidiness. The shared javadoc gate
            (exeris-systems/.github → .github/workflows/javadoc-gate.yml) resolves the reactor with
            `mvn -pl <modules> -am -DskipTests -Dcheckstyle.skip=true install`, and that step —
            unlike the two after it — takes no `extra-maven-args`, so there is no way to pass
            `-Djacoco.skip=true` in from the caller. Without this line the gate dies on
            `exeris-sdk-source-model` with "Coverage checks have not been met", which reads as a
            coverage regression and is nothing of the sort.

            Tying the two properties together says the intended thing directly: skipping the tests
            skips the gate that grades them. `mvn verify` and `mvn install` are unaffected, and the
            85% BUNDLE gate keeps its teeth on every build that runs tests at all.
        -->
        <skipTests>false</skipTests>
        <jacoco.skip>${skipTests}</jacoco.skip>
        <maven.enforcer.version>3.5.0</maven.enforcer.version>

        <!-- Semver gate (1.0.0 GA prerequisite). Configured before the freeze on
             purpose: it has to encode the record-growth stance in
             MIGRATION-0.x-to-1.0.md §3, and a gate written after the freeze would
             be written against whatever the code already did.

             The baseline is the last released version, and where it can be
             resolved FROM is what decides whether this gate runs in CI. Until
             0.12.0 the answer was nowhere: releases shipped as git tag + GitHub
             Release, consumers resolved from a local `mvn install`, and the
             baseline was therefore present on a developer machine and absent on a
             runner — hence japicmp.skip below.

             The `release` profile at the foot of this file changes that going
             forward but not retroactively. 0.12.0 is the first version to reach
             Central, so the 0.11.0 baseline named here will never be resolvable
             there and this gate stays CI-skipped for exactly one more milestone.
             It goes live when the 0.13.0 line opens against a 0.12.0 baseline
             Central can serve — at which point the -Djapicmp.skip=true in
             .github/workflows/build.yml comes off, and that flag is the thing to
             delete rather than this comment. -->
        <japicmp.version>0.23.1</japicmp.version>
        <japicmp.baseline.version>0.11.0</japicmp.baseline.version>
        <!-- Overridden to true where no baseline artifact can be resolved. -->
        <japicmp.skip>false</japicmp.skip>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.11.2</version>
                    <configuration>
                        <!--
                            The three OpenJDK contract tags (JDK-8008632), registered here so that
                            javadoc-conventions.md rule 6 can be followed at all.

                            Registration is a precondition, not a claim about the code: across this
                            reactor there is currently no @apiNote, no @implSpec and no @implNote.
                            An unregistered custom tag is itself a doclint error, and every module
                            that matters here builds with failOnWarnings=true — so the first comment
                            to adopt the vocabulary would break the build that is supposed to be
                            enforcing it. Registering them makes writing the tags possible; writing
                            them is review-level work no gate measures.

                            In pluginManagement rather than in each module: the seven gated poms
                            configure this plugin themselves, and their <configuration> merges with
                            this one instead of replacing it, so the vocabulary is declared once.
                        -->
                        <tags>
                            <tag><name>apiNote</name><placement>a</placement><head>API Note:</head></tag>
                            <tag><name>implSpec</name><placement>a</placement><head>Implementation Requirements:</head></tag>
                            <tag><name>implNote</name><placement>a</placement><head>Implementation Note:</head></tag>
                        </tags>
                    </configuration>
                </plugin>
                <!--
                    Checkstyle is never bound to a lifecycle phase here; it exists for one caller,
                    the shared Javadoc gate (exeris-systems/.github → javadoc-gate.yml), which
                    invokes `checkstyle:check` as a CLI goal and points it at the organisation
                    ruleset with -Dcheckstyle.config.location. This block exists only to pin the
                    version, so the gate cannot silently change what it enforces when a new plugin
                    release lands.

                    Deliberately absent: <configLocation>. It is the plugin's documented user
                    property, but a literal <configLocation> in a pom overrides the command line
                    SILENTLY — a bogus path passed with -D does not even fail, it is just ignored.
                    exeris-kernel hit exactly this: the shared gate ran the repository's own ruleset
                    instead of the organisation one and reported clean. If a repository-local
                    ruleset is ever wanted here, express it as a ${checkstyle.config.location}
                    property, never as a literal, so the caller can still win.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven.enforcer.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.github.siom79.japicmp</groupId>
                    <artifactId>japicmp-maven-plugin</artifactId>
                    <version>${japicmp.version}</version>
                    <configuration>
                        <skip>${japicmp.skip}</skip>
                        <oldVersion>
                            <dependency>
                                <groupId>${project.groupId}</groupId>
                                <artifactId>${project.artifactId}</artifactId>
                                <version>${japicmp.baseline.version}</version>
                                <type>jar</type>
                            </dependency>
                        </oldVersion>
                        <!-- Strict by default. The record-growth relaxation is NOT
                             here: it is declared per module, and only where records
                             actually live (exeris-sdk-source-model wholesale;
                             ApplyResult / CapManifest by name elsewhere). Two gated
                             modules — composition-lifecycle and composition-runtime —
                             have no public records at all, and do have exception
                             classes with meaningful constructor overloads, so a
                             blanket override would quietly retire a real safety net
                             in exchange for nothing. -->
                        <parameter>
                            <!-- Absent baseline must not read as "no breaks found".
                                 It reads as "not checked", loudly, and the module's
                                 own comment says where that is expected. -->
                            <ignoreMissingOldVersion>false</ignoreMissingOldVersion>
                            <onlyModified>true</onlyModified>
                            <accessModifier>public</accessModifier>
                            <breakBuildOnBinaryIncompatibleModifications>true
                            </breakBuildOnBinaryIncompatibleModifications>
                            <breakBuildOnSourceIncompatibleModifications>true
                            </breakBuildOnSourceIncompatibleModifications>
                        </parameter>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!--
        Everything a Maven Central release needs, and NOTHING the ordinary build touches.
        Activated only by `-P release`.

        The isolation is not tidiness. central-publishing-maven-plugin declares
        <extensions>true</extensions>, which makes it TAKE OVER the `deploy` phase. Declared
        outside this profile it would own every `mvn deploy` this reactor runs, and the takeover
        is silent — the symptom is an artifact not arriving where <distributionManagement> says
        it goes. Profile-scoped, the two channels stay separate by construction.

        Ported from exeris-kernel/pom.xml's `release` profile, which paid for the GPG comment
        below in a dry run. Two things are deliberately NOT ported:

        - maven-source-plugin / maven-javadoc-plugin. The kernel attaches both here because its
          modules do not. Every publishable module in this reactor already attaches them in its
          own pom, and this repo's javadoc build is strict — the annotations module has no
          dependencies, so an unresolved {@link} fails it. The kernel's block sets doclint=none
          and failOnError=false to get past ~160 findings it carries; importing it would switch
          off a gate this repo currently passes clean.

        - The cyclonedx SBOM. The kernel ships one, this reactor has never produced one, and
          adding it is its own slice rather than a rider on the change that first makes
          publishing possible. The trap to read before adding it is the kernel's own
          `skipNotDeployed` comment: <extensions>true</extensions> sets maven.deploy.skip, the
          SBOM goal skips on that by default, and a release build therefore produces none while
          the ordinary CI SBOM gate stays green.

        OSSRH shut down on 2025-06-30. nexus-staging-maven-plugin and the oss.sonatype.org URLs
        it needs no longer exist; anything describing that flow describes a dead system.
    -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!--
                        Central verifies a detached GPG signature on every file it accepts — jar,
                        sources, javadoc and pom alike.

                        No `gpgArguments`, and the absence is the point. The kernel's block used to
                        pass a loopback pinentry argument described as "what lets the passphrase
                        arrive from the environment instead of a terminal prompt", and its first
                        dry run showed the argument was dead in both directions: with a passphrase
                        available the plugin already emits loopback pinentry and a passphrase file
                        descriptor of its own accord, and without one it appends its own pinentry
                        mode of `error` AFTER the supplied argument, which gpg honours as the last
                        occurrence. Configuration that is redundant when it works and ignored when
                        it does not is worse than none, because it reads as the thing making
                        signing work.

                        What carries the passphrase is the environment variable named by
                        `passphraseEnvName`, and that name is chosen by actions/setup-java's
                        `gpg-passphrase` input, not here. The two have to agree; when they did not,
                        the kernel's failure surfaced as "gpg: signing failed: No pinentry" — a
                        message about the agent that says nothing about a name mismatch.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!--
                        autoPublish=false is not a placeholder to flip later without thinking. A
                        deployment sitting in the portal can be DROPPED; a published one cannot be
                        touched, ever. The first release goes through manual review of the portal's
                        validation results, and waitUntil=validated makes the build block until
                        there is something to review rather than exiting green on an upload.

                        <excludeArtifacts> is required, and this comment used to say the opposite.
                        exeris-sdk-annotation-catalog is a build-time generator nobody resolves and
                        must not reach Central; it holds itself back from `deploy` with
                        <maven.deploy.skip>true</maven.deploy.skip> in its own pom, and the first
                        draft here reasoned that naming it a second time would put one fact in two
                        places that can disagree.

                        A dry run refuted that. maven.deploy.skip governs maven-deploy-plugin, and
                        this plugin is not maven-deploy-plugin: it REPLACES it, and does not read
                        that property. In the log, `central-publishing:0.11.0:publish` ran on the
                        module and then reported "Installing" for all four of its files (jar, pom
                        and both signatures) into `target/central-deferred` — the staging directory
                        whose contents become the upload.

                        Left alone it would upload a coordinate with no sources jar and no javadoc
                        jar, which Central rejects per artifact — so one build-time module would
                        fail the validation of every other module's release.

                        The two settings are therefore not duplicates: they address different
                        plugins, and neither implies the other. Because that is exactly the kind of
                        pair that drifts, the release-readiness step in release.yml asserts the two
                        lists agree rather than trusting them to.
                    -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                            <excludeArtifacts>
                                <artifact>exeris-sdk-annotation-catalog</artifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
