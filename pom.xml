<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>eu.exeris</groupId>
    <artifactId>exeris-sdk-root</artifactId>
    <version>0.12.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Exeris SDK :: Root</name>
    <description>
        Exeris SDK — annotations, source model, and UI kit for Entity-First development.
        Pure API: zero runtime coupling to the Exeris kernel. Apache-2.0.
    </description>
    <url child.project.url.inherit.append.path="false">https://github.com/exeris-systems/exeris-sdk</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>Exeris Systems</name>
        <url>https://exeris.eu</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>arkstack-dev</id>
            <name>Arkadiusz Przychocki</name>
            <email>oss@exeris.eu</email>
            <organization>Exeris Systems</organization>
            <organizationUrl>https://exeris.eu</organizationUrl>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:git://github.com/exeris-systems/exeris-sdk.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/exeris-systems/exeris-sdk.git</developerConnection>
        <url>https://github.com/exeris-systems/exeris-sdk</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/exeris-systems/exeris-sdk/issues</url>
    </issueManagement>

    <distributionManagement>
        <snapshotRepository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-snapshots</url>
        </snapshotRepository>
        <repository>
            <id>central</id>
            <url>https://central.sonatype.com</url>
        </repository>
    </distributionManagement>

    <modules>
        <module>exeris-sdk-bom</module>
        <module>exeris-sdk-parent</module>

        <module>exeris-sdk-annotations</module>
        <module>exeris-sdk-source-model</module>
        <module>exeris-sdk-source-model-io</module>
        <module>exeris-sdk-composition-spec</module>
        <module>exeris-sdk-composition-lifecycle</module>
        <module>exeris-sdk-composition-runtime</module>
        <module>exeris-sdk-tck</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.source>26</maven.compiler.source>
        <maven.compiler.target>26</maven.compiler.target>
        <!-- JDK 25 LTS — the kernel's GA baseline (ADR-069, following kernel ADR-066).
             Do not raise above the kernel's baseline: these jars sit on a consumer's
             compile classpath, and a higher class-file major locks out the LTS-only
             deployments the kernel deliberately admitted. ClassFileBaselineTest guards
             the emitted major, not this property. -->
        <maven.compiler.release>25</maven.compiler.release>
        <maven.build.timestamp.format>yyyyMMdd-HHmmss</maven.build.timestamp.format>

        <!-- Coverage gate for modules that opt in via jacoco:check execution.
             Annotations module is exempt: @interface declarations have no
             executable instructions, so the metric is not meaningful there. -->
        <jacoco.version>0.8.14</jacoco.version>
        <jacoco.line.coverage.minimum>0.85</jacoco.line.coverage.minimum>
        <jacoco.instruction.coverage.minimum>0.85</jacoco.instruction.coverage.minimum>
        <maven.enforcer.version>3.5.0</maven.enforcer.version>

        <!-- Semver gate (1.0.0 GA prerequisite). Configured before the freeze on
             purpose: it has to encode the record-growth stance in
             MIGRATION-0.x-to-1.0.md §3, and a gate written after the freeze would
             be written against whatever the code already did.

             The baseline is the last released version. Releases currently ship as
             git tag + GitHub Release with downstream consumers resolving from a
             local `mvn install` (Central publishing is deliberately unwired until
             the kernel moves first), so the baseline resolves locally but not in
             CI — see japicmp.skip below. -->
        <japicmp.version>0.23.1</japicmp.version>
        <japicmp.baseline.version>0.11.0</japicmp.baseline.version>
        <!-- Overridden to true where no baseline artifact can be resolved. -->
        <japicmp.skip>false</japicmp.skip>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.11.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven.enforcer.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.github.siom79.japicmp</groupId>
                    <artifactId>japicmp-maven-plugin</artifactId>
                    <version>${japicmp.version}</version>
                    <configuration>
                        <skip>${japicmp.skip}</skip>
                        <oldVersion>
                            <dependency>
                                <groupId>${project.groupId}</groupId>
                                <artifactId>${project.artifactId}</artifactId>
                                <version>${japicmp.baseline.version}</version>
                                <type>jar</type>
                            </dependency>
                        </oldVersion>
                        <!-- Strict by default. The record-growth relaxation is NOT
                             here: it is declared per module, and only where records
                             actually live (exeris-sdk-source-model wholesale;
                             ApplyResult / CapManifest by name elsewhere). Two gated
                             modules — composition-lifecycle and composition-runtime —
                             have no public records at all, and do have exception
                             classes with meaningful constructor overloads, so a
                             blanket override would quietly retire a real safety net
                             in exchange for nothing. -->
                        <parameter>
                            <!-- Absent baseline must not read as "no breaks found".
                                 It reads as "not checked", loudly, and the module's
                                 own comment says where that is expected. -->
                            <ignoreMissingOldVersion>false</ignoreMissingOldVersion>
                            <onlyModified>true</onlyModified>
                            <accessModifier>public</accessModifier>
                            <breakBuildOnBinaryIncompatibleModifications>true
                            </breakBuildOnBinaryIncompatibleModifications>
                            <breakBuildOnSourceIncompatibleModifications>true
                            </breakBuildOnSourceIncompatibleModifications>
                        </parameter>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
