<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.exeris</groupId>
        <artifactId>exeris-sdk-parent</artifactId>
        <version>0.12.0-SNAPSHOT</version>
        <relativePath>../exeris-sdk-parent</relativePath>
    </parent>

    <artifactId>exeris-sdk-annotation-catalog</artifactId>
    <packaging>jar</packaging>

    <name>Exeris SDK :: Annotation Catalog (build-time)</name>
    <description>
        Build-time annotation processor that emits META-INF/exeris/annotation-catalog.json —
        the machine-readable description of the SDK annotation surface (names, targets,
        retention, attributes with types and defaults, deprecations with their canonical
        replacement, and the javadoc prose a class file cannot carry). It runs over
        exeris-sdk-annotations' own sources and ships its output inside that jar.
        Not published: this is a tool the SDK build uses on itself.
    </description>

    <properties>
        <!-- Not published, so there is no released baseline to compare against and
             nothing downstream can depend on. The surface that IS a contract is the
             emitted JSON, and AnnotationCatalogContractTest in exeris-sdk-annotations
             gates that — against reflection over the compiled classes, which is an
             independent mechanism rather than a restatement of this one. -->
        <japicmp.skip>true</japicmp.skip>

        <!-- Build-time tool, not a coordinate anyone resolves. Skipping deploy through the
             property rather than through plugin configuration keeps the plugin unversioned
             and out of the effective model. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- Serialization only. NOTE: this module is consumed through
             <annotationProcessorPaths>, which is a javac classpath and NOT part of
             exeris-sdk-annotations' dependency tree — the published annotations jar
             stays dependency-free, and its enforcer rule still proves it. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- This module IS the processor; nothing should process it. -->
                    <proc>none</proc>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.instruction.coverage.minimum}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.coverage.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
